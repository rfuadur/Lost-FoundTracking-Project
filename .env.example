# Copy this file to .env and fill in values for local development.
# .env is gitignored and loaded automatically via python-dotenv.

# Required unless FLASK_DEBUG=true (a dev-only insecure default is used then)
SECRET_KEY=change-me-to-a-random-secret

# Enables Flask debug mode + allows the insecure SECRET_KEY fallback above
FLASK_DEBUG=true

# Enables AI-based lost/found matching via Gemini embeddings
GOOGLE_API_KEY=your-google-api-key

# Optional: defaults to a local sqlite:///lostandfound.db if unset
DATABASE_URL=postgresql://user:password@localhost:5432/lostandfound

# Password reset emails via Mailjet's Send API (Account settings -> REST API -> API Key Management)
# MAIL_SENDER must be a validated sender in Mailjet (Account settings -> Senders & Domains).
# If unset, no email is sent; with FLASK_DEBUG=true the reset link is logged instead.
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAIL_SENDER=you@example.com
# MAIL_SENDER_NAME=Lost & Found

# Optional: seed demo admin@test.com / user@test.com accounts on startup
# SEED_DEMO_USERS=true
# DEMO_ADMIN_PASSWORD=change-me
# DEMO_USER_PASSWORD=change-me
